node_modules/
.wrangler/
.dev.vars
*.log

# Every .env file. `alpaca-paper.env` reached a PUBLIC commit (3d18cae) because
# it was untracked, unignored, and swept up by a `git add -A` — the ID inside it
# is in the history permanently. Secrets belong in `.dev.vars` (already ignored)
# or in `wrangler secret put`; this pattern is the backstop for when they do not.
*.env

# Local Claude Code permission grants — machine-specific, and publishing them
# is free reconnaissance on a public repo. .claude/skills/ IS tracked.
.claude/settings.local.json

long-tab-prompt.md

# Raw KV snapshots written by iv-capture.mjs. Kept on disk deliberately so a
# comparison can be redone offline, but they are per-day measurement data, not
# source — and they carry the whole watchlist's IV readings.
iv-capture-out/

# Build output from `wrangler deploy --dry-run --outdir dist-check`. Regenerated on
# demand and ~1.6MB; it is a STALE COPY of worker.js the moment the source moves, so
# committing it invites reading a deployment status off the wrong bytes.
dist-check/
